rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // App de uso interno con un solo usuario administrador:
    // cualquier persona autenticada en el proyecto de Firebase
    // (es decir, la cuenta admin que tú creas) puede leer y escribir.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
